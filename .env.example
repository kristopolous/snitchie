# snitchie test config. Copy to .env and fill in. .env is gitignored.
#
# KEYLESS BY DEFAULT: this suite never sends an API key, and refuses to run
# if SNITCHIE_API_KEY is set. Point it at a self-hosted keyless endpoint.
# If you deliberately want to test a PAID hosted endpoint (requests cost
# money), set both SNITCHIE_API_KEY and SNITCHIE_PAID=1 as an explicit opt-in.

# OpenAI-compatible base URL (the part before /chat/completions)
# examples:
#   http://localhost:11434/v1    (ollama)
#   http://localhost:8080        (llama.cpp server)
#   http://localhost:1234/v1     (LM Studio)
SNITCHIE_BASE_URL=http://localhost:11434/v1

# model id, as your endpoint knows it
SNITCHIE_MODEL=qwen2.5:7b

# optional:
# SNITCHIE_MAX_TURNS=4
# SNITCHIE_TEMPERATURE=0
# SNITCHIE_SEED=1234   # passed through to the endpoint if it supports seeds

# paid-endpoint opt-in (requests cost money; leave unset for keyless):
# SNITCHIE_PAID=1
# SNITCHIE_API_KEY=sk-...

# Optional: decision-model judge for test/pii-exfil.mjs. Point at any Ollama
# host serving a /v1/systemone decision model (e.g. nimble-v3). Unset -> the
# harness falls back to regex classification.
# SNITCHIE_JUDGE_URL=http://localhost:11434
# SNITCHIE_JUDGE_MODEL=nimble-v3
